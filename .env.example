DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/nabeeh
PORT=3000
APP_ORIGIN=http://localhost:3000
# Must be true behind HTTPS in production.
COOKIE_SECURE=false
DATABASE_SSL_REQUIRED=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Set only to the verified number of reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
# One free instance can use memory limits. Shared Redis is required before scaling out.
REDIS_URL=
REQUIRE_SHARED_LIMITS=false
RUN_WORKER=true
# Optional OpenAI-compatible provider, used only by the background editorial worker.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
GENERATION_DAILY_BUDGET_CENTS=0
EMBEDDING_MODEL=text-embedding-3-small
# Private uploads use PostgreSQL when no object store is configured (10 MiB/file).
# Pilot database budget: 100 MiB; set 0 to disable new database uploads.
MEDIA_DATABASE_BUDGET_BYTES=104857600
# Optional object storage is preferred when fully configured.
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=auto
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
